<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ficha do Cliente — Renata Betella Advocacia</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0D2137;
    --navy-light: #162e4a;
    --gold: #C9A84C;
    --gold-light: #e8d9b8;
    --gold-pale: #fdf6e7;
    --white: #ffffff;
    --gray-50: #f9f8f6;
    --gray-100: #f0ede8;
    --gray-300: #ccc8c0;
    --gray-500: #8a8680;
    --gray-700: #4a4743;
    --radius: 12px;
    --radius-sm: 8px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--navy);
    min-height: 100vh;
    padding: 2rem 1rem 4rem;
    color: var(--gray-700);
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 20% 10%, rgba(201,168,76,.08) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 80% 90%, rgba(201,168,76,.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .page {
    max-width: 660px;
    margin: 0 auto;
    position: relative;
  }

  /* HEADER */
  .header {
    text-align: center;
    padding: 3rem 2rem 2.5rem;
    position: relative;
  }

  .header-line {
    width: 40px;
    height: 2px;
    background: var(--gold);
    margin: 0 auto 1.5rem;
  }

  .header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--white);
    line-height: 1.2;
    margin-bottom: .75rem;
  }

  .header h1 em {
    color: var(--gold);
    font-style: normal;
  }

  .header p {
    font-size: .875rem;
    color: var(--gold-light);
    line-height: 1.7;
    max-width: 460px;
    margin: 0 auto;
    opacity: .85;
  }

  .header-line-bottom {
    width: 40px;
    height: 1px;
    background: rgba(201,168,76,.3);
    margin: 1.75rem auto 0;
  }

  /* CARD */
  .card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    margin-bottom: 1rem;
    border: 1px solid rgba(201,168,76,.12);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.5rem;
    padding-bottom: .875rem;
    border-bottom: 1px solid var(--gray-100);
  }

  .card-title-icon {
    width: 32px;
    height: 32px;
    background: var(--navy);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-title-icon svg {
    width: 16px;
    height: 16px;
    stroke: var(--gold);
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-title h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--navy);
    letter-spacing: .3px;
  }

  /* FIELDS */
  .field { margin-bottom: 1.25rem; }
  .field:last-child { margin-bottom: 0; }

  .field label {
    display: block;
    font-size: .75rem;
    font-weight: 500;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: .8px;
    margin-bottom: .5rem;
  }

  .field input[type=text],
  .field input[type=date],
  .field input[type=tel],
  .field textarea {
    width: 100%;
    padding: .75rem 1rem;
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-sm);
    font-size: .9rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--gray-700);
    background: var(--gray-50);
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,168,76,.12);
    background: var(--white);
  }

  .field textarea {
    resize: vertical;
    min-height: 90px;
    line-height: 1.6;
  }

  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  .field-note {
    font-size: .75rem;
    color: var(--gray-500);
    margin-top: .35rem;
    font-style: italic;
  }

  /* CHIPS */
  .chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: .35rem; }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border: 1px solid var(--gray-300);
    border-radius: 20px;
    font-size: .8rem;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    background: var(--white);
    color: var(--gray-700);
    transition: all .15s;
    user-select: none;
  }

  .chip:hover { border-color: var(--gold); color: var(--navy); }
  .chip.on { background: var(--navy); border-color: var(--navy); color: var(--gold); font-weight: 500; }
  .chip input { display: none; }

  /* COLOR PICKER */
  .color-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: .5rem; }

  .color-dot-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    user-select: none;
  }

  .color-dot {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: transform .15s, border-color .15s;
  }

  .color-dot-wrap.on .color-dot {
    border-color: var(--gold);
    transform: scale(1.18);
  }

  .color-dot-wrap span {
    font-size: .65rem;
    color: var(--gray-500);
    text-align: center;
  }

  .color-dot-wrap input { display: none; }

  /* RANK */
  .rank-list { display: flex; flex-direction: column; gap: 6px; margin-top: .5rem; }

  .rank-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: .75rem 1rem;
    background: var(--gray-50);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius-sm);
    cursor: grab;
    font-size: .875rem;
    color: var(--gray-700);
    transition: background .15s, box-shadow .15s;
    user-select: none;
  }

  .rank-item:active { cursor: grabbing; box-shadow: 0 4px 16px rgba(0,0,0,.1); }
  .rank-item.dragging { opacity: .4; }

  .rank-num {
    width: 22px;
    height: 22px;
    background: var(--navy);
    color: var(--gold);
    border-radius: 50%;
    font-size: .7rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rank-grip { margin-left: auto; color: var(--gray-300); font-size: .8rem; letter-spacing: .1px; }

  /* SUBMIT */
  .submit-wrap { text-align: center; padding: 1rem 0 .5rem; }

  .btn-submit {
    background: var(--gold);
    color: var(--navy);
    border: none;
    padding: 1rem 3.5rem;
    border-radius: 30px;
    font-size: .95rem;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer;
    letter-spacing: .5px;
    transition: opacity .2s, transform .15s;
  }

  .btn-submit:hover { opacity: .88; transform: translateY(-1px); }
  .btn-submit:active { transform: scale(.98); }

  /* SUCCESS */
  .success-screen {
    display: none;
    text-align: center;
    padding: 4rem 2rem;
    background: var(--white);
    border-radius: var(--radius);
    border: 1px solid rgba(201,168,76,.2);
  }

  .success-icon {
    width: 56px;
    height: 56px;
    background: var(--gold-pale);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .success-icon svg {
    width: 26px;
    height: 26px;
    stroke: var(--gold);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .success-screen h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--navy);
    margin-bottom: .5rem;
  }

  .success-screen p {
    font-size: .875rem;
    color: var(--gray-500);
    line-height: 1.7;
  }

  .footer {
    text-align: center;
    padding: 2rem 0 .5rem;
    font-size: .72rem;
    color: rgba(201,168,76,.4);
    letter-spacing: .5px;
  }

  /* HIDDEN field */
  .hidden { display: none; }

  @media (max-width: 520px) {
    .row-2 { grid-template-columns: 1fr; }
    .card { padding: 1.25rem 1.25rem; }
    .header h1 { font-size: 1.7rem; }
  }
</style>
</head>
<body>

<div class="page">

  <div class="header">
    <div class="header-line"></div>
    <h1>Ficamos felizes em<br>te conhecer <em>melhor</em> 💛</h1>
    <p>Preencha com calma. Essas informações são confidenciais e nos ajudam a cuidar de você com mais atenção e carinho.</p>
    <div class="header-line-bottom"></div>
  </div>

  <div id="form-body">

    <!-- IDENTIFICAÇÃO -->
    <div class="card">
      <div class="card-title">
        <div class="card-title-icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        </div>
        <h2>Identificação</h2>
      </div>
      <div class="row-2">
        <div class="field">
          <label>Nome completo</label>
          <input type="text" placeholder="Seu nome completo" />
        </div>
        <div class="field">
          <label>Data de nascimento</label>
          <input type="date" />
        </div>
      </div>
      <div class="field">
        <label>WhatsApp</label>
        <input type="tel" placeholder="(21) 99999-9999" />
      </div>
    </div>

    <!-- IDENTIDADE -->
    <div class="card">
      <div class="card-title">
        <div class="card-title-icon">
          <svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 0 1 4 4 4 4 0 0 1-4 4 4 4 0 0 1-4-4 4 4 0 0 1 4-4m0 10c4.42 0 8 1.79 8 4v2H4v-2c0-2.21 3.58-4 8-4z"/></svg>
        </div>
        <h2>Identidade</h2>
      </div>

      <div class="field">
        <label>Como você se identifica em relação ao gênero?</label>
        <div class="chips" id="genero">
          <label class="chip"><input type="radio" name="genero" value="mulher-cis">Mulher cisgênero</label>
          <label class="chip"><input type="radio" name="genero" value="homem-cis">Homem cisgênero</label>
          <label class="chip"><input type="radio" name="genero" value="mulher-trans">Mulher transgênero</label>
          <label class="chip"><input type="radio" name="genero" value="homem-trans">Homem transgênero</label>
          <label class="chip"><input type="radio" name="genero" value="nao-binario">Não binário</label>
          <label class="chip"><input type="radio" name="genero" value="prefiro-nao-dizer">Prefiro não dizer</label>
          <label class="chip"><input type="radio" name="genero" value="outro">Outro</label>
        </div>
      </div>
      <div class="field hidden" id="genero-outro-field">
        <label>Como prefere ser identificado(a)?</label>
        <input type="text" placeholder="Descreva como preferir" />
      </div>

      <div class="field" style="margin-top:1.25rem">
        <label>Como você se declara em relação à cor/raça?</label>
        <p class="field-note">Classificação do IBGE</p>
        <div class="chips" id="raca" style="margin-top:.5rem">
          <label class="chip"><input type="radio" name="raca" value="branca">Branca</label>
          <label class="chip"><input type="radio" name="raca" value="preta">Preta</label>
          <label class="chip"><input type="radio" name="raca" value="parda">Parda</label>
          <label class="chip"><input type="radio" name="raca" value="amarela">Amarela</label>
          <label class="chip"><input type="radio" name="raca" value="indigena">Indígena</label>
          <label class="chip"><input type="radio" name="raca" value="prefiro-nao-dizer">Prefiro não dizer</label>
        </div>
      </div>
    </div>

    <!-- DATAS ESPECIAIS -->
    <div class="card">
      <div class="card-title">
        <div class="card-title-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <h2>Datas especiais</h2>
      </div>
      <div class="field">
        <label>Dia e mês do seu aniversário</label>
        <input type="text" placeholder="Ex: 15 de março" />
      </div>
      <div class="field">
        <label>Você tem filhos? Se sim, quantos e quais as idades?</label>
        <input type="text" placeholder="Ex: Dois filhos, 8 e 12 anos" />
      </div>
      <div class="field">
        <label>Alguma outra data especial que queira compartilhar?</label>
        <input type="text" placeholder="Ex: Aniversário de casamento em julho" />
      </div>
    </div>

    <!-- GOSTOS PESSOAIS -->
    <div class="card">
      <div class="card-title">
        <div class="card-title-icon">
          <svg viewBox="0 0 24 24"><path d="M20 12c0 4.4-3.6 8-8 8s-8-3.6-8-8 3.6-8 8-8c1.7 0 3.2.5 4.5 1.4"/><path d="M20 4l-8 8-3-3"/></svg>
        </div>
        <h2>Gostos pessoais</h2>
      </div>

      <div class="field">
        <label>Qual é a sua cor favorita?</label>
        <div class="color-row" id="cor-fav">
          <label class="color-dot-wrap"><input type="radio" name="cor" value="vermelho"><div class="color-dot" style="background:#C0392B"></div><span>Vermelho</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="rosa"><div class="color-dot" style="background:#E91E8C"></div><span>Rosa</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="roxo"><div class="color-dot" style="background:#7B2FBE"></div><span>Roxo</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="azul"><div class="color-dot" style="background:#1565C0"></div><span>Azul</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="verde"><div class="color-dot" style="background:#2E7D32"></div><span>Verde</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="amarelo"><div class="color-dot" style="background:#F9A825"></div><span>Amarelo</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="laranja"><div class="color-dot" style="background:#E65100"></div><span>Laranja</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="branco"><div class="color-dot" style="background:#F5F5F5;border:1px solid #ccc"></div><span>Branco</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="preto"><div class="color-dot" style="background:#212121"></div><span>Preto</span></label>
          <label class="color-dot-wrap"><input type="radio" name="cor" value="dourado"><div class="color-dot" style="background:#C9A84C"></div><span>Dourado</span></label>
          <label class="color-dot-wrap" id="cor-outra-opt"><input type="radio" name="cor" value="outra"><div class="color-dot" style="background:conic-gradient(red,yellow,lime,cyan,blue,magenta,red)"></div><span>Outra</span></label>
        </div>
        <div class="field hidden" id="cor-outra-field" style="margin-top:.75rem">
          <input type="text" placeholder="Qual cor?" />
        </div>
      </div>

      <div class="field">
        <label>Quais são seus hobbies ou atividades favoritas?</label>
        <div class="chips" id="hobbies">
          <label class="chip"><input type="checkbox" name="hobby" value="leitura">Leitura</label>
          <label class="chip"><input type="checkbox" name="hobby" value="musica">Música</label>
          <label class="chip"><input type="checkbox" name="hobby" value="cinema">Cinema / séries</label>
          <label class="chip"><input type="checkbox" name="hobby" value="viagens">Viagens</label>
          <label class="chip"><input type="checkbox" name="hobby" value="gastronomia">Gastronomia</label>
          <label class="chip"><input type="checkbox" name="hobby" value="esportes">Esportes</label>
          <label class="chip"><input type="checkbox" name="hobby" value="arte">Arte / artesanato</label>
          <label class="chip"><input type="checkbox" name="hobby" value="natureza">Natureza / trilhas</label>
          <label class="chip"><input type="checkbox" name="hobby" value="jogos">Jogos</label>
          <label class="chip"><input type="checkbox" name="hobby" value="fotografia">Fotografia</label>
          <label class="chip"><input type="checkbox" name="hobby" value="moda">Moda / estilo</label>
          <label class="chip"><input type="checkbox" name="hobby" value="bemestar">Bem-estar / yoga</label>
        </div>
        <div class="field" style="margin-top:.75rem">
          <input type="text" placeholder="Outro hobby que não está na lista?" />
        </div>
      </div>

      <div class="field">
        <label>O que você mais prioriza na vida atualmente?</label>
        <p class="field-note">Arraste para ordenar do mais ao menos importante</p>
        <div class="rank-list" id="rank-list">
          <div class="rank-item" draggable="true" data-val="familia"><span class="rank-num">1</span>Família<span class="rank-grip">⠿</span></div>
          <div class="rank-item" draggable="true" data-val="saude"><span class="rank-num">2</span>Saúde<span class="rank-grip">⠿</span></div>
          <div class="rank-item" draggable="true" data-val="carreira"><span class="rank-num">3</span>Carreira / trabalho<span class="rank-grip">⠿</span></div>
          <div class="rank-item" draggable="true" data-val="financas"><span class="rank-num">4</span>Finanças / segurança<span class="rank-grip">⠿</span></div>
          <div class="rank-item" draggable="true" data-val="lazer"><span class="rank-num">5</span>Lazer e descanso<span class="rank-grip">⠿</span></div>
          <div class="rank-item" draggable="true" data-val="espiritualidade"><span class="rank-num">6</span>Espiritualidade / fé<span class="rank-grip">⠿</span></div>
        </div>
      </div>

      <div class="field">
        <label>Preferência por chocolate?</label>
        <div class="chips" id="choco">
          <label class="chip"><input type="radio" name="choco" value="ao-leite">Ao leite</label>
          <label class="chip"><input type="radio" name="choco" value="meio-amargo">Meio amargo</label>
          <label class="chip"><input type="radio" name="choco" value="amargo">Amargo</label>
          <label class="chip"><input type="radio" name="choco" value="branco">Branco</label>
          <label class="chip"><input type="radio" name="choco" value="nao-gosto">Não gosto</label>
        </div>
      </div>

      <div class="field">
        <label>Restrição alimentar ou alergia?</label>
        <input type="text" placeholder="Ex: Intolerante a lactose, alérgico a amendoim..." />
      </div>

      <div class="field">
        <label>Flor preferida</label>
        <input type="text" placeholder="Ex: Girassol, rosa, orquídea..." />
      </div>

      <div class="field">
        <label>O que você adora receber de presente?</label>
        <div class="chips" id="presente">
          <label class="chip"><input type="checkbox" name="presente" value="livros">Livros</label>
          <label class="chip"><input type="checkbox" name="presente" value="vinhos">Vinhos</label>
          <label class="chip"><input type="checkbox" name="presente" value="spa">Spa / bem-estar</label>
          <label class="chip"><input type="checkbox" name="presente" value="gastronomia">Gastronomia</label>
          <label class="chip"><input type="checkbox" name="presente" value="flores">Flores</label>
          <label class="chip"><input type="checkbox" name="presente" value="roupas">Roupas / acessórios</label>
          <label class="chip"><input type="checkbox" name="presente" value="experiencias">Experiências</label>
          <label class="chip"><input type="checkbox" name="presente" value="doces">Doces / guloseimas</label>
        </div>
      </div>

      <div class="field">
        <label>Algo mais que queira nos contar?</label>
        <textarea placeholder="Time de futebol, série favorita, destino dos sonhos... pode à vontade!"></textarea>
      </div>
    </div>

    <!-- COMUNICAÇÃO -->
    <div class="card">
      <div class="card-title">
        <div class="card-title-icon">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h2>Comunicação</h2>
      </div>

      <div class="field">
        <label>Como prefere ser chamado(a) por nós?</label>
        <input type="text" placeholder="Apelido ou primeiro nome" />
      </div>

      <div class="field">
        <label>Melhor canal para contato</label>
        <div class="chips" id="canal">
          <label class="chip"><input type="radio" name="canal" value="whatsapp">WhatsApp</label>
          <label class="chip"><input type="radio" name="canal" value="email">E-mail</label>
          <label class="chip"><input type="radio" name="canal" value="ligacao">Ligação</label>
        </div>
      </div>

      <div class="field">
        <label>Melhor período para contato</label>
        <div class="chips" id="periodo">
          <label class="chip"><input type="radio" name="periodo" value="manha">Manhã</label>
          <label class="chip"><input type="radio" name="periodo" value="tarde">Tarde</label>
          <label class="chip"><input type="radio" name="periodo" value="noite">Noite</label>
          <label class="chip"><input type="radio" name="periodo" value="qualquer">Qualquer horário</label>
        </div>
      </div>
    </div>

    <div class="submit-wrap">
      <button class="btn-submit" onclick="enviar()">Enviar ficha</button>
    </div>

  </div>

  <div class="success-screen" id="success">
    <div class="success-icon">
      <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
    </div>
    <h2>Muito obrigada por compartilhar!</h2>
    <p>Suas informações foram recebidas com carinho.<br>Vamos usá-las para cuidar de você com ainda mais atenção. 💛</p>
  </div>

  <div class="footer">RENATA BETELLA ADVOCACIA E CONSULTORIA JURÍDICA</div>

</div>

<script>
  // chips
  document.querySelectorAll('.chips .chip').forEach(chip => {
    chip.addEventListener('click', function() {
      const inp = this.querySelector('input');
      if (inp.type === 'radio') {
        this.closest('.chips').querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
        this.classList.add('on');
        if (this.closest('#genero')) {
          document.getElementById('genero-outro-field').classList.toggle('hidden', inp.value !== 'outro');
        }
      } else {
        this.classList.toggle('on');
      }
    });
  });

  // color dots
  document.querySelectorAll('.color-dot-wrap').forEach(opt => {
    opt.addEventListener('click', function() {
      document.querySelectorAll('.color-dot-wrap').forEach(o => o.classList.remove('on'));
      this.classList.add('on');
      document.getElementById('cor-outra-field').classList.toggle('hidden', this.querySelector('input').value !== 'outra');
    });
  });

  // drag to rank
  const rankList = document.getElementById('rank-list');
  let dragged = null;

  rankList.addEventListener('dragstart', e => {
    dragged = e.target.closest('.rank-item');
    setTimeout(() => dragged.classList.add('dragging'), 0);
  });
  rankList.addEventListener('dragend', () => {
    dragged.classList.remove('dragging');
    dragged = null;
    updateNums();
  });
  rankList.addEventListener('dragover', e => {
    e.preventDefault();
    const over = e.target.closest('.rank-item');
    if (over && over !== dragged) {
      const rect = over.getBoundingClientRect();
      if (e.clientY < rect.top + rect.height / 2) rankList.insertBefore(dragged, over);
      else rankList.insertBefore(dragged, over.nextSibling);
    }
  });

  function updateNums() {
    rankList.querySelectorAll('.rank-item').forEach((item, i) => {
      item.querySelector('.rank-num').textContent = i + 1;
    });
  }

  // submit
  function enviar() {
    document.getElementById('form-body').style.display = 'none';
    document.getElementById('success').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>

</body>
</html>
